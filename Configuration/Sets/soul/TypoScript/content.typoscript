# The content elements: the core's types, and the ones the core does not
# have. Every template here emits the system's elements and no class of
# its own.
lib.contentElement {
  templateRootPaths.1727 = EXT:theme_soul/Resources/Private/Templates/Content/
  partialRootPaths.1727 = EXT:theme_soul/Resources/Private/Templates/Partials/
  layoutRootPaths.1727 = EXT:theme_soul/Resources/Private/Templates/Layouts/

  # The layout of the page an element stands on. A list of sections is
  # the contents beside a column, and the pills across a band.
  variables.pageLayout = TEXT
  variables.pageLayout.data = pagelayout

  # What a slide and a deck say in every foot.
  settings.soul {
    product = {$soul.product}
    brand = {$soul.brand}
    signet = {$soul.signet}
  }
}

tt_content.menu_section.dataProcessing.1727 = soul-sections
tt_content.menu_section.dataProcessing.1727.from = menu

# The core's table and list of terms, as the data the elements take.
tt_content.table.dataProcessing.1727 = soul-table
tt_content.bullets.dataProcessing.1727 = soul-lines
tt_content.bullets.dataProcessing.1727 {
  shape = facts
  as = facts
}

tt_content.soul_hero =< lib.contentElement
tt_content.soul_hero {
  templateName = SoulHero
  dataProcessing.10 = files
  dataProcessing.10.references.fieldName = assets
}

tt_content.soul_note =< lib.contentElement
tt_content.soul_note.templateName = SoulNote

tt_content.soul_code =< lib.contentElement
tt_content.soul_code.templateName = SoulCode

tt_content.soul_quote =< lib.contentElement
tt_content.soul_quote.templateName = SoulQuote

tt_content.soul_accordion =< lib.contentElement
tt_content.soul_accordion.templateName = SoulAccordion

tt_content.soul_tabs =< lib.contentElement
tt_content.soul_tabs.templateName = SoulTabs

tt_content.soul_steps =< lib.contentElement
tt_content.soul_steps.templateName = SoulSteps

tt_content.soul_timeline =< lib.contentElement
tt_content.soul_timeline.templateName = SoulTimeline

tt_content.soul_stats =< lib.contentElement
tt_content.soul_stats.templateName = SoulStats

tt_content.soul_surfaces =< lib.contentElement
tt_content.soul_surfaces.templateName = SoulSurfaces

tt_content.soul_cards =< lib.contentElement
tt_content.soul_cards.templateName = SoulCards

tt_content.soul_icons =< lib.contentElement
tt_content.soul_icons.templateName = SoulIcons

tt_content.soul_facts =< lib.contentElement
tt_content.soul_facts {
  templateName = SoulFacts
  # After the core's record-transformation, which makes the entries.
  dataProcessing.1770716913 = soul-entries
  dataProcessing.1770716913.fields {
    term = header
    value = text
  }
}

tt_content.soul_register =< lib.contentElement
tt_content.soul_register.templateName = SoulRegister

tt_content.soul_decision =< lib.contentElement
tt_content.soul_decision.templateName = SoulDecision

tt_content.soul_compare =< lib.contentElement
tt_content.soul_compare {
  templateName = SoulCompare
  dataProcessing.10 = files
  dataProcessing.10.references.fieldName = assets
}

tt_content.soul_embed =< lib.contentElement
tt_content.soul_embed.templateName = SoulEmbed

tt_content.soul_copy =< lib.contentElement
tt_content.soul_copy.templateName = SoulCopy

tt_content.soul_progress =< lib.contentElement
tt_content.soul_progress.templateName = SoulProgress

tt_content.soul_confval =< lib.contentElement
tt_content.soul_confval.templateName = SoulConfval

tt_content.soul_swatches =< lib.contentElement
tt_content.soul_swatches.templateName = SoulSwatches

tt_content.soul_dialog =< lib.contentElement
tt_content.soul_dialog.templateName = SoulDialog

tt_content.soul_diff =< lib.contentElement
tt_content.soul_diff {
  templateName = SoulDiff
  dataProcessing.10 = soul-lines
  dataProcessing.10.shape = diff
}

tt_content.soul_tree =< lib.contentElement
tt_content.soul_tree {
  templateName = SoulTree
  dataProcessing.10 = soul-lines
  dataProcessing.10.shape = tree
}

tt_content.soul_run =< lib.contentElement
tt_content.soul_run {
  templateName = SoulRun
  # After the core's record-transformation, which makes the entries.
  dataProcessing.1770716913 = soul-entries
  dataProcessing.1770716913.fields {
    label = header
    state = state
    meta = label
    note = note
    output = text
  }
}

tt_content.soul_slide =< lib.contentElement
tt_content.soul_slide {
  templateName = SoulSlide
  dataProcessing.10 = files
  dataProcessing.10.references.fieldName = assets
