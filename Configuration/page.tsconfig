# Off for every site, and on again in the set's page TSconfig. The types
# and the fields of this theme then appear only on a site that takes it.
TCEFORM.tt_content {
  CType.removeItems := addToList(soul_hero,soul_note,soul_code,soul_quote,soul_accordion,soul_tabs,soul_steps,soul_timeline,soul_stats,soul_surfaces,soul_cards,soul_icons,soul_facts,soul_register,soul_decision,soul_compare,soul_embed,soul_copy,soul_progress,soul_diff,soul_tree,soul_confval,soul_swatches,soul_run,soul_dialog,soul_slide,soul_deck)
  tx_themesoul_tone.disabled = 1
  tx_themesoul_code_lang.disabled = 1
  tx_themesoul_action.disabled = 1
  tx_themesoul_items.disabled = 1
  tx_themesoul_columns.disabled = 1
  tx_themesoul_by.disabled = 1
  tx_themesoul_due.disabled = 1
  tx_themesoul_value.disabled = 1
  tx_themesoul_max.disabled = 1
  tx_themesoul_ratio.disabled = 1
  tx_themesoul_flag.disabled = 1
  tx_themesoul_state.disabled = 1
  tx_themesoul_kind.disabled = 1
}
